---
interface Props {
  dashboardId: string;
}

const { dashboardId } = Astro.props;
---

<div class="dashboard-wrapper">
  <div id="superset-container"></div>
</div>

<script>
  import { embedDashboard } from "@superset-ui/embedded-sdk";

  const container = document.getElementById("superset-container");

  if (container) {
    embedDashboard({
      id: "28313aaa-145a-402f-80a0-5bf831bf4702", // Replace with your UUID from Superset
      supersetDomain: "https://mtg.alejandroojedacelis.com",
      mountPoint: container,
      fetchGuestToken: async () => {
        // If your dashboard relies on the 'Public' role without guest tokens,
        // you can return an empty string or hit a public endpoint.
        return "";
      },
      dashboardUiConfig: {
        hideTitle: true,
        hideTab: true,
        hideChartControls: false,
      },
    });
  }
</script>

<style>
  .dashboard-wrapper {
    width: 100%;
    min-height: 800px;
    border-radius: 12px;
    overflow: hidden;
    background: #111;
  }

  /* Target the dynamic iframe generated by Superset SDK */
  #superset-container :global(iframe) {
    width: 100%;
    height: 850px;
    border: none;
  }
</style>