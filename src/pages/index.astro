---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Home" description="Portfolio and engineering profile of Alejandro Ojeda-Celis.">
  <!-- Hero Section -->
  <section class="page-head section hero-section">
    <p class="eyebrow">Alejandro Ojeda-Celis</p>
    <h1>Software & Data Engineer</h1>
    <p class="lead">
      Building scalable Python ETL pipelines, optimizing PostgreSQL databases, and streamlining enterprise workflows.
    </p>
    <div class="hero-actions">
      <a href={withBase('/works/')} class="btn primary-btn">View Featured Works</a>
      <a href="/Alejandro_Ojeda-Celis_Resume_8-2-26.pdf" target="_blank" class="btn secondary-btn">Download Resume (PDF)</a>
    </div>
  </section>

  <!-- Core Competencies Grid -->
  <section class="section">
    <p class="eyebrow">Core Competencies</p>
    <div class="skills-grid">
      <article class="skill-card">
        <h3>Data Engineering</h3>
        <p>Python (Pandas), Google Cloud Platform, BigQuery, Automated ETL Ingestion & Cron Jobs</p>
      </article>
      <article class="skill-card">
        <h3>Database Architecture</h3>
        <p>PostgreSQL, Supabase, Advanced SQL (Window Functions, Aggregations, Performance Tuning)</p>
      </article>
      <article class="skill-card">
        <h3>Full-Stack & Systems</h3>
        <p>TypeScript, Docker, REST APIs, Technical Systems Diagnostics & CRM Support</p>
      </article>
    </div>
  </section>

  <!-- Quick Overview / Value Proposition -->
  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Overview</p>
      <h2>Engineering meets operational execution.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Computer Science graduate from UT Arlington with hands-on experience building production data pipelines and full-stack web applications.
      </p>
      <p>
        Focused on building resilient systems that process complex data cleanly and reducing operational friction through clear technical feedback and automation.
      </p>
      <p class="cta-link">
        <a href={withBase('/about/')}>Read full background and experience →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .primary-btn {
    background-color: var(--color-text, #ffffff);
    color: var(--color-bg, #111111);
  }

  .primary-btn:hover {
    opacity: 0.9;
  }

  .secondary-btn {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-text, #ffffff);
  }

  .secondary-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .skill-card {
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
  }

  .skill-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .skill-card p {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.4;
  }

  .cta-link {
    margin-top: 1rem;
    font-weight: 500;
  }
</style>